// Prisma schéma pre FEI Finder
// Definuje štruktúru databázy (tabuľky a stĺpce)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Model pre študijný program
// Ukladá všetky programy FEI (popis a typické povolania zobrazované na detail stránke)
model Program {
  id          Int      @id @default(autoincrement())
  name        String
  field       String
  description String?  @db.Text
  occupations String?  @db.Text
  subjects    Json?    // vlastné predmety na detaile; null = fallback lib/programProfiles
  createdAt   DateTime @default(now())
  
  results     Result[]
}

// Model pre používateľa/študenta
// Ukladá základné info o tom, kto vyplnil formulár
model Account {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  
  users     User[]
}

model User {
  id                  Int       @id @default(autoincrement())
  name                String
  email               String
  school              String
  location            String?   // odkiaľ je (mesto / región)
  age                 Int?      // vek v rokoch
  wantsToStudyAtTUKE  Boolean?  // či chce študovať na TUKE
  howDidYouHear       String[]
  howDidYouHearOther  String?
  whyThisSchool       String[]
  expectations        String[]
  interests           String[]
  experience          String[]
  consentGivenAt      DateTime?
  createdAt           DateTime  @default(now())
  
  accountId  Int?
  account    Account? @relation(fields: [accountId], references: [id])
  
  results    Result[]
}

// Model pre výsledok odporúčania
// Ukladá, aké programy boli odporúčané a s akým skóre
model Result {
  id        Int      @id @default(autoincrement())
  score     Int
  createdAt DateTime @default(now())
  
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  programId Int
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
}

// Aktivity katedry
model DepartmentActivity {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  category    String
  link        String?
  createdAt   DateTime @default(now())
}

// Úspechy študentov
model StudentAchievement {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  studentName  String
  category     String
  year         Int
  link         String?
  createdAt    DateTime @default(now())
}

// Blog (články z admin rozhrania)
// section: aktivity = Aktivity katedry, studijne = Študijné aktuality
model BlogPost {
  id          Int       @id @default(autoincrement())
  title       String
  content     String    @db.Text
  summary     String?
  section     String    @default("aktivity") // "aktivity" | "studijne"
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

